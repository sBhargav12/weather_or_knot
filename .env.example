POLYGON_RPC=
POLYMARKET_START_BLOCK=33605403

# Kalshi paper-trading pipeline
KALSHI_API_KEY=
KALSHI_KEY_PATH=~/.kalshi/key.pem

# wethr.net API
WETHR_API_KEY=

# Optional phone notifications via ntfy.
# Install the ntfy phone app and subscribe to this topic.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# ecCodes native library (required for GRIB2 decoding of GEFS data)
# Install: brew install eccodes
# Then set:  ECCODES_DIR=$(brew --prefix eccodes)
ECCODES_DIR=/opt/homebrew/opt/eccodes
